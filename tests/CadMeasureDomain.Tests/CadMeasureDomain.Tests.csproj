<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Тот же net8.0 и x64, что у доменного проекта: иначе ссылка на него
         не разрешится при сборке решения с -p:Platform=x64. -->
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Version.props здесь намеренно не подключается: он включает
         GenerateDocumentationFile и IDE0005-как-ошибку для поставляемого кода.
         Тесты не поставляются, и требовать XML-документацию к каждому Fact — шум. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CadMeasureDomain\CadMeasureDomain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
