<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CadMeasurePlugin.UI.MaterialEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление материала"
        SizeToContent="Height"
        Width="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FFF3F3F3"
        Foreground="#FF1E1E1E"
        FontSize="12">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">
        <TextBlock x:Name="HeaderText"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,2" />
        <TextBlock x:Name="ClassText"
                   Foreground="#FF555555"
                   Margin="0,0,0,10" />

        <!-- Форма сечения — только для воздуховодов -->
        <StackPanel x:Name="ShapePanel" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock Text="Сечение:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <RadioButton x:Name="RectShapeButton"
                         Content="Прямоугольное"
                         GroupName="DuctShape"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"
                         Checked="Shape_Checked" />
            <RadioButton x:Name="RoundShapeButton"
                         Content="Круглое"
                         GroupName="DuctShape"
                         VerticalAlignment="Center"
                         Checked="Shape_Checked" />
        </StackPanel>

        <!-- Вид изделия — только для штучных позиций -->
        <StackPanel x:Name="PieceKindPanel" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock Text="Вид изделия:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="PieceKindBox" Width="280" Padding="4,3" SelectionChanged="PieceKind_Changed" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование:" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="0" Grid.Column="1"
                     x:Name="NameBox"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     ToolTip="Полное наименование, как в спецификации. Должно быть уникальным."
                     TextChanged="Field_Changed" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ед. изм.:" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="1"
                     x:Name="UnitBox"
                     Width="110"
                     HorizontalAlignment="Left"
                     TextChanged="Field_Changed" />

            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="Field1Label" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="2" Grid.Column="1"
                     x:Name="Field1Box"
                     Width="130"
                     HorizontalAlignment="Left"
                     PreviewTextInput="Number_PreviewTextInput"
                     TextChanged="Field_Changed" />

            <TextBlock Grid.Row="3" Grid.Column="0" x:Name="Field2Label" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="3" Grid.Column="1"
                     x:Name="Field2Box"
                     Width="130"
                     HorizontalAlignment="Left"
                     PreviewTextInput="Number_PreviewTextInput"
                     TextChanged="Field_Changed" />

            <TextBlock Grid.Row="4" Grid.Column="0" x:Name="Field3Label" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="4" Grid.Column="1"
                     x:Name="Field3Box"
                     Width="130"
                     HorizontalAlignment="Left"
                     PreviewTextInput="Number_PreviewTextInput"
                     TextChanged="Field_Changed" />
        </Grid>

        <TextBlock Text="Дробные значения вводятся с запятой или точкой: 3,5 или 3.5"
                   Foreground="#FF6B6B6B"
                   Margin="0,0,0,8" />

        <Border Background="#FFE9E9E9" Padding="8,6">
            <StackPanel>
                <TextBlock x:Name="PreviewCharacteristicText" TextWrapping="Wrap" />
                <TextBlock x:Name="PreviewLayerText" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText"
                   Foreground="#FFB00020"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="Collapsed" />

        <TextBlock x:Name="TargetFileText"
                   Foreground="#FF6B6B6B"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Сохранить" IsDefault="True" Padding="14,5" MinWidth="110" Click="Save_Click" />
            <Button Content="Отмена" IsCancel="True" Padding="14,5" MinWidth="96" Margin="6,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
