<Window x:Class="CadMeasurePlugin.UI.ColumnVisibilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Столбцы спецификации"
        Height="420"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="12">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Какие столбцы показывать в таблице журнала"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                   Text="На состав выгрузки в Excel это не влияет — он задаётся отдельно, в параметрах экспорта."
                   TextWrapping="Wrap"
                   Foreground="#FF6B6B6B"
                   Margin="0,0,0,8" />

        <ListBox x:Name="ColumnsList" Grid.Row="2" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Title}"
                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                              Margin="2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Показать все" Width="110" Height="26" Margin="0,0,6,0" Click="SelectAll_Click" />
            <Button Content="ОК" Width="90" Height="26" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Отмена" Width="90" Height="26" IsCancel="True" />
        </WrapPanel>
    </Grid>
</Window>
