<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CadMeasurePlugin.UI.MeasurePaletteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="380"
             Background="#FFF3F3F3"
             Foreground="#FF1E1E1E"
             FontSize="12">

    <!--
        Порядок блоков повторяет порядок работы: спецификация → материал
        и участок → замер → журнал → экспорт. На панели остаётся только то,
        чем пользуются в каждом замере; всё остальное — в меню «Ещё»
        и в контекстном меню таблицы.
    -->

    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="MinWidth" Value="110" />
        </Style>

        <!--
            Меню «Ещё» и меню заголовков таблицы собираются в коде
            (BuildMoreMenu, BuildHeaderMenu). В разметке им не место:
            обработчики событий внутри ресурсов и стилей WPF привязать
            не может — загрузка палитры падает с «Set connectionId threw
            an exception», причём в рантайме, а не при сборке.
        -->
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 1. СПЕЦИФИКАЦИЯ ================= -->
        <GroupBox Grid.Row="0" Header="Спецификация проекта" Padding="6" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SpecificationStatusText"
                           Text="Не загружена — журнал ведётся только по чертежу"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="#FF505050" />

                <WrapPanel Grid.Column="1">
                    <Button x:Name="LoadSpecificationButton"
                            Content="Загрузить"
                            Style="{StaticResource ActionButton}"
                            MinWidth="100"
                            ToolTip="Импорт спецификации из Excel. Материалы, которых нет в реестре, заводятся автоматически"
                            Click="LoadSpecification_Click" />
                    <!--
                        Кнопка одна: если спецификация уже загружена, она же
                        с подтверждением заменяет её. Удаление спецификации —
                        действие редкое, оно лежит в меню «Ещё».
                    -->
                </WrapPanel>
            </Grid>
        </GroupBox>

        <!-- ================= 2. МАТЕРИАЛ И УЧАСТОК ================= -->
        <GroupBox Grid.Row="1" Header="Материал и участок" Padding="6" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                           x:Name="SelectedMaterialText"
                           Text="Материал не выбран"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                           x:Name="LayerInfoText"
                           Foreground="#FF6B6B6B"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Участок:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBox Grid.Row="2" Grid.Column="1"
                         x:Name="SectionBox"
                         Padding="3"
                         VerticalAlignment="Center"
                         ToolTip="Зона / часть проекта. Можно менять в любой момент."
                         TextChanged="SectionBox_TextChanged" />
                <Button Grid.Row="2" Grid.Column="2"
                        Content="Выбрать материал"
                        Padding="10,4"
                        Margin="6,0,0,0"
                        ToolTip="Окно выбора с поиском по реестру. Там же материалы добавляются, копируются и удаляются"
                        Click="SelectMaterial_Click" />
            </Grid>
        </GroupBox>

        <!-- ================= 3. ЗАМЕР ================= -->
        <GroupBox Grid.Row="2" Header="Замер" Padding="6" Margin="0,0,0,6">
            <StackPanel>
                <WrapPanel>
                    <!-- Текст меняется на «Начать подсчет» для штучных изделий. -->
                    <Button x:Name="StartMeasureButton"
                            Content="Начать замер"
                            Style="{StaticResource ActionButton}"
                            MinWidth="140"
                            FontWeight="Bold"
                            Click="StartDrawing_Click" />
                    <!-- Вертикальные участки бессмысленны для штучных: кнопки гасятся. -->
                    <Button x:Name="RiseButton"
                            Content="Подъём"
                            Style="{StaticResource ActionButton}"
                            MinWidth="80"
                            ToolTip="Добавить вертикальный участок вверх (длина в мм)"
                            Click="Rise_Click" />
                    <Button x:Name="DropButton"
                            Content="Опуск"
                            Style="{StaticResource ActionButton}"
                            MinWidth="80"
                            ToolTip="Добавить вертикальный участок вниз (длина в мм)"
                            Click="Drop_Click" />
                </WrapPanel>

                <TextBlock x:Name="VerticalTotalsText"
                           Foreground="#FF6B6B6B"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
        </GroupBox>

        <!-- ================= 4. ЖУРНАЛ ================= -->
        <GroupBox Grid.Row="3" Padding="6" Margin="0,0,0,6">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="JournalHeaderText" Text="Журнал замеров" FontWeight="Bold" />
                    <TextBlock x:Name="AutoRefreshText"
                               Margin="10,0,0,0"
                               Foreground="#FF3C7D3C"
                               ToolTip="Журнал пересчитывается сам после изменений чертежа, журнала и реестра материалов" />
                </StackPanel>
            </GroupBox.Header>

            <DockPanel>
                <!--
                    Фильтра на панели нет: он нужен изредка, в большом журнале,
                    а место занимал бы всегда. Вызывается из контекстного меню
                    таблицы; когда фильтр включён, об этом прямо сказано
                    в заголовке журнала — иначе скрытые строки легко принять
                    за пропавшие.

                    Двойной клик по строке выбирает её материал (см. JournalGrid_MouseDoubleClick).
                    Обработчик не помечает событие обработанным, поэтому штатное
                    редактирование ячейки по двойному клику продолжает работать.
                -->
                <DataGrid x:Name="JournalGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          SelectionUnit="Cell"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          RowHeaderWidth="0"
                          EnableRowVirtualization="True"
                          AlternatingRowBackground="#FFF7F7F7"
                          ColumnWidth="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="JournalGrid_MouseDoubleClick"
                          BeginningEdit="JournalGrid_BeginningEdit"
                          CellEditEnding="JournalGrid_CellEditEnding">

                    <!-- ПКМ по строке — действия над записью. -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Показать в чертеже" Click="ShowInDrawing_Click" />
                            <MenuItem Header="Показать только этот замерный слой" Click="IsolateRecordLayer_Click" />
                            <Separator />
                            <MenuItem Header="Редактировать данные спецификации" Click="EditSpecificationRow_Click" />
                            <MenuItem Header="Привязать к позиции спецификации…" Click="BindToSpecification_Click" />
                            <MenuItem Header="Отвязать от спецификации" Click="UnbindFromSpecification_Click" />
                            <Separator />
                            <MenuItem Header="Удалить запись из журнала" Click="DeleteRecord_Click" />
                            <Separator />
                            <MenuItem Header="Настроить столбцы таблицы" Click="ConfigureSpecificationColumns_Click" />
                            <MenuItem Header="Фильтр журнала…" Click="OpenJournalFilter_Click" />
                            <MenuItem Header="Сбросить фильтр журнала" Click="ResetJournalFilter_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip"
                                    Value="Двойной клик — сделать материал строки текущим. ПКМ — действия над записью" />
                            <Style.Triggers>
                                <!-- Строка с ручным значением больше не следует за чертежом. -->
                                <DataTrigger Binding="{Binding HasManualValue}" Value="True">
                                    <Setter Property="Background" Value="#FFFFF6E0" />
                                    <Setter Property="ToolTip"
                                            Value="Значение задано вручную и не пересчитывается по чертежу. Очисти ячейку, чтобы вернуть измеренное." />
                                </DataTrigger>

                                <!-- Поля спецификации в строке введены руками, а не прочитаны из файла. -->
                                <DataTrigger Binding="{Binding SpecificationEditedManually}" Value="True">
                                    <Setter Property="Background" Value="#FFEAF3FF" />
                                    <Setter Property="ToolTip"
                                            Value="Данные спецификации в этой строке введены вручную. При перезагрузке файла спецификации их придётся ввести заново." />
                                </DataTrigger>

                                <!--
                                    Позиция спецификации, которой не нашлось материала
                                    в реестре. Замерять её нечем: слой строится
                                    по материалу, поэтому строку видно сразу.
                                -->
                                <DataTrigger Binding="{Binding MaterialMissing}" Value="True">
                                    <Setter Property="Background" Value="#FFFFE0E0" />
                                    <Setter Property="ToolTip"
                                            Value="Материал не найден в реестре. Выбери в колонке наименования подходящую позицию реестра — до этого замер по строке невозможен." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!--
                        Столбцы «Тип» и «Характеристика» намеренно не выводятся:
                        и класс, и размеры уже содержатся в наименовании материала.
                        В модели они остаются и попадают в Excel.

                        Все редактируемые колонки привязаны OneWay: запись значения
                        идёт не через привязку, а через JournalEditService в
                        CellEditEnding. Иначе смена материала или участка меняла бы
                        только текст в таблице, не трогая слой и геометрию.

                        Видимость столбцов задаётся кодом (ApplyDefaultColumnVisibility):
                        без спецификации показываются столбцы чертежа, со
                        спецификацией — столбцы проекта. Меняется через
                        «Настроить столбцы таблицы».
                    -->
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="SpecificationNumberColumn"
                                            Header="п/п"
                                            Binding="{Binding SpecificationItemId, Mode=OneWay}"
                                            Width="45"
                                            Visibility="Collapsed"
                                            IsReadOnly="True" />

                        <DataGridComboBoxColumn x:Name="MaterialColumn"
                                                Header="Наименование материала"
                                                Width="300"
                                                SelectedValueBinding="{Binding MaterialName, Mode=OneWay}">
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <!-- Позиций сотни: разрешаем набор с клавиатуры для быстрого поиска. -->
                                    <Setter Property="IsEditable" Value="True" />
                                    <Setter Property="IsTextSearchEnabled" Value="True" />
                                    <Setter Property="IsTextSearchCaseSensitive" Value="False" />
                                    <Setter Property="StaysOpenOnEdit" Value="True" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>

                        <DataGridTextColumn Header="Ед. изм."
                                            Binding="{Binding StatementUnit, Mode=OneWay}"
                                            Width="70"
                                            IsReadOnly="True" />

                        <DataGridTextColumn x:Name="SpecificationQuantityColumn"
                                            Header="Кол-во (спец.)"
                                            Binding="{Binding SpecificationQuantity, Mode=OneWay, StringFormat=N2}"
                                            Width="110"
                                            Visibility="Collapsed" />

                        <DataGridTextColumn x:Name="QuantityColumn"
                                            Header="Подсчитано"
                                            Binding="{Binding QuantityDisplay, Mode=OneWay}"
                                            Width="100" />

                        <DataGridTextColumn x:Name="SpecificationDifferenceColumn"
                                            Header="Расхождение"
                                            Binding="{Binding SpecificationDifference, Mode=OneWay, StringFormat=N2}"
                                            Width="110"
                                            Visibility="Collapsed"
                                            IsReadOnly="True" />

                        <!--
                            Поля спецификации редактируются только там, где импорт
                            их не прочитал: перебивать данные, которые в файле есть,
                            значило бы тихо разойтись с проектом. Правило проверяется
                            в JournalGrid_BeginningEdit.
                        -->
                        <DataGridTextColumn x:Name="SpecificationMarkColumn"
                                            Header="Марка"
                                            Binding="{Binding Mark, Mode=OneWay}"
                                            Width="120"
                                            Visibility="Collapsed" />
                        <DataGridTextColumn x:Name="SpecificationCodeColumn"
                                            Header="Код"
                                            Binding="{Binding EquipmentCode, Mode=OneWay}"
                                            Width="100"
                                            Visibility="Collapsed" />
                        <DataGridTextColumn x:Name="SpecificationManufacturerColumn"
                                            Header="Изготовитель"
                                            Binding="{Binding Manufacturer, Mode=OneWay}"
                                            Width="140"
                                            Visibility="Collapsed" />
                        <DataGridTextColumn x:Name="SpecificationUnitColumn"
                                            Header="Ед. изм. (спец.)"
                                            Binding="{Binding Unit, Mode=OneWay}"
                                            Width="110"
                                            Visibility="Collapsed" />

                        <DataGridTextColumn x:Name="SectionColumn"
                                            Header="Участок"
                                            Binding="{Binding Section, Mode=OneWay}"
                                            Width="130" />

                        <!-- Слой и файл DWG вычисляются, руками их не правят. -->
                        <DataGridTextColumn x:Name="LayerColumn"
                                            Header="Слой"
                                            Binding="{Binding LayerName, Mode=OneWay}"
                                            Width="180"
                                            IsReadOnly="True" />
                        <DataGridTextColumn x:Name="DrawingColumn"
                                            Header="Файл DWG"
                                            Binding="{Binding DrawingFileName, Mode=OneWay}"
                                            Width="150"
                                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <!-- ================= 5. ЭКСПОРТ ================= -->
        <WrapPanel Grid.Row="4">
            <Button Content="Экспорт в Excel"
                    Style="{StaticResource ActionButton}"
                    MinWidth="150"
                    FontWeight="Bold"
                    ToolTip="Со спецификацией сначала спросит состав книги: листы, строки и столбцы"
                    Click="Export_Click" />
            <Button x:Name="MoreButton"
                    Content="Ещё…"
                    Style="{StaticResource ActionButton}"
                    MinWidth="90"
                    ToolTip="Таблица в чертеже, видимость слоёв, подписи, столбцы, очистка журнала, диагностика"
                    Click="More_Click" />
        </WrapPanel>

        <!-- ================= СТРОКА СОСТОЯНИЯ ================= -->
        <Border Grid.Row="5" Background="#FFE6E6E6" Padding="6,4" Margin="0,4,0,0">
            <TextBlock x:Name="StatusText"
                       Text="Готово."
                       TextWrapping="Wrap"
                       Foreground="#FF303030" />
        </Border>
    </Grid>
</UserControl>
