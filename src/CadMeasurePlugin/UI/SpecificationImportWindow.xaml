<Window x:Class="CadMeasurePlugin.UI.SpecificationImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт позиций спецификации"
        Height="560"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="12">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />

        <!--
            Кнопки массового выбора вынесены наверх: в спецификации бывают
            сотни строк, и отмечать их поштучно никто не станет.
        -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <Button Content="Выбрать все" Width="110" Height="26" Margin="0,0,6,0" Click="SelectAll_Click" />
            <Button Content="Снять все" Width="110" Height="26" Margin="0,0,6,0" Click="SelectNone_Click" />
            <Button Content="Только замеряемые" Width="150" Height="26" Margin="0,0,6,0"
                    ToolTip="Отметить позиции, у которых распознана единица измерения и найден материал в реестре"
                    Click="SelectMeasurable_Click" />
            <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF505050" />
        </WrapPanel>

        <DataGrid x:Name="ItemsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  RowHeaderWidth="0"
                  AlternatingRowBackground="#FFF7F7F7"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- Единица не распознана: замерять позицию нечем. -->
                        <DataTrigger Binding="{Binding IsSupported}" Value="False">
                            <Setter Property="Background" Value="#FFFFF6E0" />
                            <Setter Property="ToolTip" Value="Единица измерения не распознана — позицию нельзя замерить" />
                        </DataTrigger>
                        <!-- Нет материала в реестре: слой строить не из чего. -->
                        <DataTrigger Binding="{Binding HasMaterial}" Value="False">
                            <Setter Property="Background" Value="#FFFFE0E0" />
                            <Setter Property="ToolTip" Value="Материал не найден в реестре — привяжи его в журнале перед замером" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓"
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                        Width="34" />
                <DataGridTextColumn Header="п/п" Binding="{Binding Number}" Width="45" IsReadOnly="True" />
                <DataGridTextColumn Header="Наименование материала" Binding="{Binding Name}" Width="360" IsReadOnly="True" />
                <DataGridTextColumn Header="Марка" Binding="{Binding Mark}" Width="120" IsReadOnly="True" />
                <DataGridTextColumn Header="Ед. изм." Binding="{Binding Unit}" Width="70" IsReadOnly="True" />
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat=N2}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Материал реестра" Binding="{Binding MaterialState}" Width="150" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="ОК" Width="110" Height="28" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Отмена" Width="110" Height="28" IsCancel="True" />
        </WrapPanel>
    </Grid>
</Window>
