<Window x:Class="CadMeasurePlugin.UI.SpecificationPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Позиция спецификации"
        Height="480"
        Width="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="12">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="SearchBox" Padding="3" TextChanged="Search_TextChanged" />
        </DockPanel>

        <ListBox x:Name="ItemsList"
                 Grid.Row="1"
                 DisplayMemberPath="Display"
                 MouseDoubleClick="Items_MouseDoubleClick" />

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Привязать" Width="110" Height="28" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Отмена" Width="110" Height="28" IsCancel="True" />
        </WrapPanel>
    </Grid>
</Window>
