<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CadMeasurePlugin.UI.VerticalRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вертикальный участок"
        SizeToContent="Height"
        Width="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FFF3F3F3"
        Foreground="#FF1E1E1E"
        FontSize="12">

    <StackPanel Margin="14">
        <TextBlock x:Name="HeaderText"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,6" />

        <TextBlock x:Name="MaterialText"
                   TextWrapping="Wrap"
                   Foreground="#FF555555"
                   Margin="0,0,0,10" />

        <TextBlock Text="Длина участка, мм:" Margin="0,0,0,4" />
        <TextBox x:Name="LengthBox"
                 Padding="4,4"
                 FontSize="14"
                 PreviewTextInput="LengthBox_PreviewTextInput" />

        <TextBlock x:Name="ErrorText"
                   Foreground="#FFB00020"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <TextBlock x:Name="TotalsText"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="#FF555555" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Добавить" IsDefault="True" Padding="14,5" MinWidth="96" Click="Ok_Click" />
            <Button Content="Отмена" IsCancel="True" Padding="14,5" MinWidth="96" Margin="6,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
